# Copy to .env and edit. Every value is optional — the defaults are what the
# public deployment runs with.
#
# Run `npm run doctor` after changing anything here to confirm it still answers.

PORT=3000
LOG_LEVEL=info

# --- GTFS timetable -------------------------------------------------------
#
# There is deliberately no download URL to set. The archive is discovered at
# runtime from the city's data API, which returns the whole set of dated
# snapshots; the server picks the newest one whose effective date has already
# arrived. A hardcoded resource UUID on a portal the city then retired is
# exactly what broke this project once already.

# The dataset endpoint answers with bare file ids ({"pliki": [119, 117, …]}),
# each of which is resolved separately; the download URL is then built from
# GTFS_DOWNLOAD_BASE because the metadata does not carry one.
# GTFS_CATALOGUE_URL=https://api.open-data.cui.wroclaw.pl/od2/6/
# GTFS_DOWNLOAD_BASE=https://open-data.cui.wroclaw.pl/hdb/download
# GTFS_MAX_FILE_LOOKUPS=24
# GTFS_CKAN_HOSTS=https://opendata.cui.wroclaw.pl
# GTFS_MIRROR_URLS=https://api.dane.gov.pl/resources/1823,rozklad-jazdy-transportu-publicznego-gtfs/file

# Debugging escape hatch: pin one archive URL and skip discovery entirely.
# Do NOT set this in production — it freezes you on one timetable version,
# which then goes stale with no error anywhere.
# GTFS_URLS=

# When to re-check for a new snapshot (cron, Europe/Warsaw).
# GTFS_REFRESH_CRON=30 3 * * *

# Set to false on a memory-constrained host to skip the per-stop departure
# index; /stop/:id/departures then returns nothing but the map still works.
# GTFS_BUILD_STOP_INDEX=true

# --- Live vehicle positions -----------------------------------------------
# MPK's own endpoint. The request body encoding is negotiated automatically.
# VEHICLE_POSITION_URLS=https://mpk.wroc.pl/bus_position
# VEHICLE_POLL_INTERVAL_MS=10000

# --- Service alerts -------------------------------------------------------
# Default and, out of the box, only source: reads @AlertMPK's public posts
# through a Nitter mirror's RSS feed instead of the paid X API (which is why
# TWITTER_BEARER_TOKEN never worked without payment) or scraping X's own
# markup. This is fragile in a different way — public Nitter instances go
# down with no notice — so verify against the real feed before deploying, and
# whenever alerts go stale:
#   npm run scrape:nitter
# A deploy against a source that has silently broken gets zero alerts until
# someone notices, since ALERT_PAGE_URLS below is empty by default. Set
# NITTER_ENABLED to false to turn this source off entirely.
# NITTER_ENABLED=true
#
# NITTER_INSTANCE_URLS is a comma separated list of Nitter mirrors, tried in
# order until one answers — the same pattern used for GTFS and vehicle
# sources above, because a single public instance is not something to depend
# on staying up.
# NITTER_INSTANCE_URLS=https://nitter.net
# NITTER_USERNAME=AlertMPK
# NITTER_MAX_POSTS=10
# NITTER_TIMEOUT_MS=15000

# Optional extra source, empty by default. Pages are read as RSS/Atom if they
# parse as a feed, and scraped as HTML otherwise. Only add a page that carries
# live disruptions — a company news page passes for a notice list and turns
# press releases into alerts (mpk.wroc.pl/o-mpk/aktualnosci is news, not
# disruptions). `npm run doctor` prints the headlines each source yields; if
# they read like announcements, the source is wrong.
# ALERT_PAGE_URLS=https://www.wroclaw.pl/komunikacja/zmiany-w-komunikacji

# --- HTTP -----------------------------------------------------------------
# CORS_ORIGINS=https://example.com
# TRUST_PROXY=false

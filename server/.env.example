# Copy to .env and edit. Every value is optional — the defaults are what the
# public deployment runs with.
#
# Run `npm run doctor` after changing anything here to confirm it still answers.

PORT=3000
LOG_LEVEL=info

# --- GTFS timetable -------------------------------------------------------
#
# There is deliberately no download URL to set. The archive is discovered at
# runtime from the city's data API, which returns the whole set of dated
# snapshots; the server picks the newest one whose effective date has already
# arrived. A hardcoded resource UUID on a portal the city then retired is
# exactly what broke this project once already.

# The dataset endpoint answers with bare file ids ({"pliki": [119, 117, …]}),
# each of which is resolved separately; the download URL is then built from
# GTFS_DOWNLOAD_BASE because the metadata does not carry one.
# GTFS_CATALOGUE_URL=https://api.open-data.cui.wroclaw.pl/od2/6/
# GTFS_DOWNLOAD_BASE=https://open-data.cui.wroclaw.pl/hdb/download
# GTFS_MAX_FILE_LOOKUPS=24
# GTFS_CKAN_HOSTS=https://opendata.cui.wroclaw.pl
# GTFS_MIRROR_URLS=https://api.dane.gov.pl/resources/1823,rozklad-jazdy-transportu-publicznego-gtfs/file

# Debugging escape hatch: pin one archive URL and skip discovery entirely.
# Do NOT set this in production — it freezes you on one timetable version,
# which then goes stale with no error anywhere.
# GTFS_URLS=

# When to re-check for a new snapshot (cron, Europe/Warsaw).
# GTFS_REFRESH_CRON=30 3 * * *

# Set to false on a memory-constrained host to skip the per-stop departure
# index; /stop/:id/departures then returns nothing but the map still works.
# GTFS_BUILD_STOP_INDEX=true

# --- Live vehicle positions -----------------------------------------------
# MPK's own endpoint. The request body encoding is negotiated automatically.
# VEHICLE_POSITION_URLS=https://mpk.wroc.pl/bus_position
# VEHICLE_POLL_INTERVAL_MS=10000
#
# Supplementary source: the city's live vehicle table. MPK stays primary; the
# records here are merged onto the nearest same-line vehicle (giving each one
# a vehicle number, brigade and position time) and fresh ones with no match
# are served as `source: "open-data"` — so a bus is still on the map when one
# of the two feeds goes down. Polled on its own 15 s timer.
# OPEN_DATA_VEHICLE_URL=https://open-data.cui.wroclaw.pl/hdb/db/14?download=json
# OPEN_DATA_POLL_INTERVAL_MS=15000
# OPEN_DATA_MAX_AGE_MS=90000
#
# Merge thresholds, metres: an Open Data record is matched to the closest
# same-line, same-type MPK vehicle only within VEHICLE_MATCH_MAX_METERS; it is
# suppressed as a duplicate when any same-line MPK vehicle is within
# VEHICLE_DEDUPE_MAX_METERS; two candidates closer together than
# VEHICLE_MATCH_AMBIGUITY_METERS are too ambiguous to guess between.
# VEHICLE_MATCH_MAX_METERS=250
# VEHICLE_DEDUPE_MAX_METERS=350
# VEHICLE_MATCH_AMBIGUITY_METERS=75

# --- Service alerts -------------------------------------------------------
# NOTHING IS CONFIGURED BY DEFAULT — a stock deploy serves no alerts at all.
# @AlertMPK on X is the account that publishes real disruptions, and every
# route to it needs something you supply (see the block below). Set one up, or
# /alerts stays empty.
#
# Whatever you configure, verify it before deploying and whenever alerts go
# stale:
#   npm run scrape:alerts
# It prints what each source actually yields. A source that has silently
# broken gets zero alerts until someone notices, so this is worth doing rather
# than assuming.

# Notice pages, comma separated and tried independently. Empty by default and
# NOT a substitute for @AlertMPK: these carry *planned* changes — stop
# relocations, roadworks, event closures — not incidents, and serving them as
# the alert feed buries the one notice that is actually going wrong. Add one
# when you want the planned changes as well.
#
# A page that states its lines and window per notice
#   linie: N 128 130 242 251
#   obowiązuje: 03.09.2026 - 08.09.2026
#   05.09.2026r. - tymczasowa zmiana lokalizacji przystanku Brücknera (24105)
# is read by parseStructuredNotices() — the lines are taken as stated and a
# notice past its last day is dropped. A page without that form is read as
# RSS/Atom if it offers a feed, and scraped for headlines otherwise. Only add
# one carrying dated notices: mpk.wroc.pl/o-mpk/aktualnosci is corporate news,
# and pointing the scraper at it turned "MPK kupuje nowe tramwaje" into a
# service alert.
# ALERT_PAGE_URLS=https://www.wroclaw.pl/komunikacja/zmiany-w-komunikacji

# THE ALERTS SOURCE: @AlertMPK's posts, read through an RSS bridge — any
# service that republishes a public X profile as plain RSS. Unset by default
# only because the bridge has to be yours: there is no free API path to a
# timeline (that has needed a paid tier since 2023, which is why
# TWITTER_BEARER_TOKEN never worked without payment), and pointing at someone
# else's public bridge is what left this project with no alerts at all when
# Nitter shut down. Run one and it cannot be taken away from you.
#
# Standing one up, e.g. RSSHub:
#   docker run -d --restart unless-stopped -p 1200:1200 diygod/rsshub
#   ALERT_X_BRIDGE_URLS=http://127.0.0.1:1200/twitter/user/{username}
# RSSHub's X routes need their own credentials configured (see its docs); the
# server does not care which bridge answers, only that it returns RSS.
#
# Comma separated URL templates, tried in order until one answers — run a
# second bridge and list it here to survive the first going down. Each entry
# carries {username}; an entry without it is treated as a Nitter-shaped base
# URL (<base>/<username>/rss) so a private mirror still works.
# ALERT_X_BRIDGE_URLS=https://rsshub.example.com/twitter/user/{username}
# ALERT_X_USERNAME=AlertMPK
# ALERT_X_MAX_POSTS=10
# ALERT_X_TIMEOUT_MS=15000
#
# Configuring a bridge above is what turns this source on. Set this to false
# to keep it off without deleting the URLs.
# ALERT_X_BRIDGE_ENABLED=true
#
# An empty feed is treated as a failure, not as "no disruptions today" — a
# discontinued bridge answers 200 with an empty channel, and that read as zero
# alerts is exactly how the Nitter outage stayed invisible. Check
# /health -> alerts.providers[].lastError when alerts go quiet.

# --- AI incident timelines (server only, disabled by default) -------------
# AI enrichment is opt-in and runs only in this backend. Never put these keys
# in the Expo app or in any EXPO_PUBLIC_* variable.

# OFF (default): no provider calls, no AI cost; /alerts works normally.
AI_ALERTS_ENABLED=false
AI_ALERTS_PROVIDER=off
AI_ALERTS_TIMEOUT_MS=90000
# AI_ALERTS_TIMEOUT_MS=20000
# AI_ALERTS_CACHE_TTL_MS=86400000
# AI_ALERTS_MAX_INPUT_ALERTS=30
# AI_ALERTS_TEMPERATURE=0.1

# OpenRouter
# Hosted, requires both a key and an explicit model, and may cost
# money. Uncomment this block instead of the OFF block above.
# AI_ALERTS_ENABLED=true
# AI_ALERTS_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=

# Command Code Provider API
# Hosted and may cost money. CMD_API_KEY is
# preferred; CMDC_API_KEY is accepted as a compatibility alias.
# AI_ALERTS_ENABLED=true
# AI_ALERTS_PROVIDER=cmdc
# CMD_API_KEY=
# CMDC_BASE_URL=https://api.commandcode.ai/provider/v1
# CMDC_MODEL=deepseek/deepseek-v4-flash

# Ollama local
# Runs locally and has no hosted-provider charge, but OLLAMA_MODEL must
# already be pulled and the Ollama service must be running.
# AI_ALERTS_ENABLED=true
# AI_ALERTS_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=

# --- HTTP -----------------------------------------------------------------
# CORS_ORIGINS=https://example.com
# TRUST_PROXY=false

# --- PT KŁOSOK (live bus positions) ---------------------------------------
# A subcontractor running suburban bus lines (911, 921, 931, ...) in Wrocław
# and the surrounding gminy. Publishes one public GTFS-RT protobuf feed of
# live positions with no timetable of its own — buses are matched against the
# Wrocław GTFS above (trip id, then route id, then vehicle/brigade), so no
# separate static feed is needed. Merged into /locations, deduplicated
# against MPK / Open Data (a fresh Kłosok fix outranks both for the same bus),
# and served as type "bus" — no new line category or marker. An outage never
# takes MPK or the Open Data source down; `npm run doctor:klosok` checks it.
# KLOSOK_ENABLED=true
# KLOSOK_GTFS_RT_URL=https://mapadlugoleka.klosok.eu/vehicle_positions.pb
# KLOSOK_POLL_INTERVAL_MS=10000
# KLOSOK_TIMEOUT_MS=10000
# KLOSOK_MAX_AGE_MS=90000
# KLOSOK_DEDUPE_METERS=300
#
# The feed's certificate chains to Let's Encrypt's new "Root YE" (leaf -> YE2
# intermediate -> ISRG Root YE), which not every host's CA store carries yet —
# Node then rejects the leaf (UNABLE_TO_VERIFY_LEAF_SIGNATURE) and Kłosok goes
# silent while MPK still works. This defaults to true, relaxing TLS for THIS
# ONE endpoint only via a dedicated undici Agent in src/klosok/fetch.js; MPK
# and Open Data keep full verification and nothing is disabled globally (no
# NODE_TLS_REJECT_UNAUTHORIZED). Set it to false to restore strict verification
# once Kłosok serves a chain your hosts trust.
# KLOSOK_TLS_ALLOW_INVALID_CERT=true
# KLOSOK_TLS_ALLOW_INVALID_CERT=false

# --- Admin dashboard ------------------------------------------------------
# Set this to enable /admin, the token-protected dashboard: usage stats, the
# same health payload /health serves (upstream sources, alert providers, the
# AI error), and an editor for the AI model. Without it the routes are
# disabled entirely. Use a long random value, e.g. `openssl rand -hex 32`.
# ADMIN_TOKEN=
#
# The model set from the dashboard is written to runtime-settings.json in
# STATS_CACHE_DIR and applied on the next refresh; it survives a restart and
# is announced in the boot log when it disagrees with the value here. Delete
# that file to go back to .env. Nothing else is settable at runtime — in
# particular the base URL and key stay here, since a settable base URL would
# let anyone holding ADMIN_TOKEN redirect the provider, and the API key it
# sends, to a server of their own.

# Usage stats. Counting runs regardless of the dashboard; these tune it.
# STATS_ENABLED=true
# STATS_SAVE_INTERVAL_MS=300000
# STATS_DAYS_TO_KEEP=31
# STATS_CLIENT_POLL_INTERVAL_MS=10000
# STATS_TIMEZONE=Europe/Warsaw
# STATS_CACHE_DIR=

# Response caches. SHAPE_CACHE_ENTRIES bounds the route-shape cache;
# VEHICLE_DETAIL_CACHE_ENTRIES bounds the per-vehicle detail cache served by
# /vehicle/:id (one entry per vehicle, limit and history combination).
# SHAPE_CACHE_ENTRIES=200
# VEHICLE_DETAIL_CACHE_ENTRIES=512

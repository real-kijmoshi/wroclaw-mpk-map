# Copy to .env and edit. Every value here is optional — the defaults in
# src/config.js are what the public deployment runs with.
#
# Run `npm run doctor` after changing any URL to confirm it actually answers.

PORT=3000
LOG_LEVEL=info

# Comma-separated, tried in order until one works. Add a new URL at the FRONT
# when the city or MPK moves an endpoint again.
# GTFS_URLS=https://www.wroclaw.pl/open-data/87b09b32-f076-4475-8ec9-6020ed1f9ac0/OtwartyWroclaw_rozklad_jazdy_GTFS.zip
# VEHICLE_POSITION_URLS=https://mpk.wroc.pl/bus_position
# ALERT_FEED_URLS=https://www.wroclaw.pl/komunikacja/rss,https://www.mpk.wroc.pl/feed

# How often to poll live positions, in milliseconds.
# VEHICLE_POLL_INTERVAL_MS=10000

# When to re-download the timetable (cron, Europe/Warsaw).
# GTFS_REFRESH_CRON=30 3 * * *

# Set to false on a memory-constrained host to skip the per-stop departure
# index; /stop/:id/departures then returns nothing but everything else works.
# GTFS_BUILD_STOP_INDEX=true

# Restrict which origins may call the API. Default is "*".
# CORS_ORIGINS=https://example.com,https://app.example.com

# Optional: reading @mpkwroclaw posts needs a PAID X API tier. Without a token
# the alerts come from the RSS feeds above only.
# TWITTER_BEARER_TOKEN=

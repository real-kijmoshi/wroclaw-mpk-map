{
  "name": "wroclaw-mpk-map-server",
  "version": "1.0.1",
  "description": "Real-time API for Wrocław public transport: lines, vehicle positions, route shapes, stop departures and service alerts.",
  "main": "index.js",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test test/*.test.js",
    "doctor": "node scripts/doctor.js",
    "doctor:klosok": "node scripts/doctor.js --klosok",
    "lint": "eslint .",
    "benchmark:progress": "node --expose-gc scripts/benchmark-progress.js",
    "benchmark:open-data": "node --expose-gc scripts/benchmark-open-data.js",
    "scrape:alerts": "node scripts/verify-alerts.js"
  },
  "keywords": [
    "wroclaw",
    "mpk",
    "gtfs",
    "public-transport",
    "realtime"
  ],
  "dependencies": {
    "adm-zip": "^0.6.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "gtfs-realtime-bindings": "^2.2.0",
    "node-cron": "^4.6.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "eslint": "^9.28.0"
  }
}

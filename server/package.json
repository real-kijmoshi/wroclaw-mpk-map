{
  "name": "wroclaw-mpk-map-server",
  "version": "1.0.0",
  "description": "Real-time API for Wrocław public transport: lines, vehicle positions, route shapes, stop departures and service alerts.",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test test/*.test.js",
    "doctor": "node scripts/doctor.js",
    "doctor:kd": "node scripts/doctor.js --kd",
    "doctor:klosok": "node scripts/doctor.js --klosok",
    "lint": "eslint .",
    "benchmark:progress": "node --expose-gc scripts/benchmark-progress.js",
    "benchmark:open-data": "node --expose-gc scripts/benchmark-open-data.js",
    "scrape:nitter": "node scripts/verify-nitter.js"
  },
  "keywords": [
    "wroclaw",
    "mpk",
    "gtfs",
    "public-transport",
    "realtime"
  ],
  "dependencies": {
    "adm-zip": "^0.5.16",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "node-cron": "^4.1.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "eslint": "^9.28.0"
  }
}

{
  "expo": {
    "name": "wroclive",
    "slug": "wroclive",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wroclive",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/30a32c44-ef2b-4751-8f7b-f3fc2aa58dd2",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDFDFD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "package": "com.kijmoshi.wroclive"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "locationWhenInUsePermission": "Pozwól, aby pokazać Twoją pozycję i najbliższe przystanki na mapie.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": true,
          "widgets": [
            {
              "name": "Departures",
              "displayName": "Odjazdy",
              "description": "Najbliższe odjazdy z ulubionego przystanku.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline",
                  "accessoryCircular"
                ],
                "configuration": {
                  "title": "Przystanek",
                  "description": "Który z ulubionych przystanków pokazać.",
                  "parameters": {
                    "slot": {
                      "title": "Ulubiony przystanek",
                      "type": "enum",
                      "values": [
                        { "name": "Pierwszy", "value": "first" },
                        { "name": "Drugi", "value": "second" },
                        { "name": "Trzeci", "value": "third" }
                      ],
                      "default": "first"
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      "expo-web-browser",
      "expo-background-task",
      "./plugins/without-background-fetch"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30a32c44-ef2b-4751-8f7b-f3fc2aa58dd2"
      }
    },
    "owner": "kijmoshi",
    "ios": {
      "bundleIdentifier": "com.kijmoshi.wroclive",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
